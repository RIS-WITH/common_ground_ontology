<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_objects#"
     xml:base="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_objects#"
     xmlns:cg_objects="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_objects#"
     xmlns:cg_entities="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_entities#"
     xmlns:cg_language="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_language#"
     xmlns:onto="ontologenius"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_objects">
      <owl:imports rdf:resource="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_entities"/>
      <owl:imports rdf:resource="https://github.com/RIS-WITH/common_ground_ontology/blob/master/CG_language"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->
    


    <!-- cg_objects#Box -->

    <owl:Class rdf:about="cg_objects#Box">
        <rdfs:subClassOf rdf:resource="cg_objects#Container"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrFemaleGender"/>
        <rdfs:label xml:lang="fr">boite</rdfs:label>
        <rdfs:label xml:lang="en">box</rdfs:label>
    </owl:Class>
    

    <!-- cg_objects#Container -->

    <owl:Class rdf:about="cg_objects#Container">
        <rdfs:subClassOf rdf:resource="cg_objects#Object"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <rdfs:label xml:lang="en">container</rdfs:label>
        <rdfs:label xml:lang="fr">conteneur</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#Cube -->

    <owl:Class rdf:about="cg_objects#Cube">
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_objects#Support"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <rdfs:label xml:lang="en">block</rdfs:label>
        <rdfs:label xml:lang="fr">cube</rdfs:label>
        <cg_entities:hasMesh rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/cube.stl</cg_entities:hasMesh>
        <onto:label xml:lang="en">cube</onto:label>
    </owl:Class>
    

    <!-- cg_objects#Fan -->

    <owl:Class rdf:about="cg_objects#Fan">
        <rdfs:subClassOf rdf:resource="cg_objects#Object"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <rdfs:label xml:lang="en">fan</rdfs:label>
        <rdfs:label xml:lang="fr">ventilateur</rdfs:label>
    </owl:Class>
      

    <!-- cg_objects#Mug -->

    <owl:Class rdf:about="cg_objects#Mug">
        <rdfs:subClassOf rdf:resource="cg_objects#Container"/>
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrFemaleGender"/>
        <cg_entities:hasMesh rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/mug.obj</cg_entities:hasMesh>
        <cg_entities:hasTexture rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/textures/mug.png</cg_entities:hasTexture>
        <rdfs:label xml:lang="en">mug</rdfs:label>
        <rdfs:label xml:lang="fr">tasse</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#Object -->

    <owl:Class rdf:about="cg_objects#Object">
        <rdfs:subClassOf rdf:resource="cg_entities#PhysicalEntity"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <rdfs:label xml:lang="en">object</rdfs:label>
        <rdfs:label xml:lang="fr">objet</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#PaperBin -->

    <owl:Class rdf:about="cg_objects#PaperBin">
        <rdfs:subClassOf rdf:resource="cg_objects#Container"/>
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrFemaleGender"/>
        <cg_entities:hasMesh rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/paper_bin.obj</cg_entities:hasMesh>
        <cg_entities:hasTexture rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/textures/paper_bin.png</cg_entities:hasTexture>
        <rdfs:label xml:lang="en">paper bin</rdfs:label>
        <rdfs:label xml:lang="fr">poubelle</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#Pen -->

    <owl:Class rdf:about="cg_objects#Pen">
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <cg_entities:hasMesh rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/pen.obj</cg_entities:hasMesh>
        <cg_entities:hasTexture rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/textures/pen.png</cg_entities:hasTexture>
        <rdfs:label xml:lang="en">pen</rdfs:label>
        <rdfs:label xml:lang="fr">stylo</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#Pickable -->

    <owl:Class rdf:about="cg_objects#Pickable">
        <rdfs:subClassOf rdf:resource="cg_objects#Object"/>
    </owl:Class>
    


    <!-- cg_objects#Pint -->

    <owl:Class rdf:about="cg_objects#Pint">
        <rdfs:subClassOf rdf:resource="cg_objects#Container"/>
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrFemaleGender"/>
        <cg_entities:hasMesh rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/pint.obj</cg_entities:hasMesh>
        <cg_entities:hasTexture rdf:datatype="http://www.w3.org/2001/XMLSchema#string">package://common_ground_ontology/meshes/furnitures/pint.png</cg_entities:hasTexture>
        <rdfs:label xml:lang="en">pint</rdfs:label>
        <rdfs:label xml:lang="fr">pinte</rdfs:label>
    </owl:Class>
    


    <!-- cg_objects#PostIt -->

    <owl:Class rdf:about="cg_objects#PostIt">
        <rdfs:subClassOf rdf:resource="cg_objects#Pickable"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
        <rdfs:label xml:lang="en">post-it</rdfs:label>
        <rdfs:label xml:lang="fr">post-it</rdfs:label>
    </owl:Class>
       

    <!-- cg_objects#Support -->

    <owl:Class rdf:about="cg_objects#Support">
        <rdfs:subClassOf rdf:resource="cg_objects#Object"/>
        <rdfs:subClassOf rdf:resource="cg_language#FrMaleGender"/>
    </owl:Class>
    
    
    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

</rdf:RDF>
